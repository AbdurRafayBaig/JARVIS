# JARVIS Configuration
# Copy this file to .env and fill in your values

# ==========================================
# LLM PROVIDER SETTINGS
# ==========================================
# Provider: openai, anthropic, ollama, llama_cpp
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ==========================================
# SPEECH-TO-TEXT
# ==========================================
# Provider: whisper_cpp (local faster-whisper), openai, google
STT_PROVIDER=whisper_cpp
STT_MODEL=base.en
STT_LANGUAGE=en
STT_API_KEY=

# ==========================================
# TEXT-TO-SPEECH
# ==========================================
# Provider: system (Windows SAPI, no setup), piper, edge
# "piper" sounds best but needs a voice model in %APPDATA%\Jarvis	ts_models;
# JARVIS falls back to "system" automatically when no model is installed.
TTS_PROVIDER=system
TTS_MODEL=en_US-lessac-medium
TTS_VOICE=
TTS_SPEED=1.0
TTS_API_KEY=

# ==========================================
# WAKE WORD
# ==========================================
JARVIS_WAKE_WORD=jarvis
WAKE_WORD_SENSITIVITY=0.5
# Hands-free wake-word detection uses Picovoice Porcupine, which needs a free
# access key from https://console.picovoice.ai. Without it JARVIS still works
# through the orb, the global hotkey and the text panel.
PV_ACCESS_KEY=

# ==========================================
# AGENT SETTINGS
# ==========================================
MAX_AGENT_STEPS=30
MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=300
ENABLE_VERIFICATION=true
ENABLE_RECOVERY=true

# ==========================================
# VOICE SETTINGS
# ==========================================
VOICE_ENABLED=true
MICROPHONE_DEVICE_INDEX=0
SPEAKER_DEVICE_INDEX=0
VOICE_VOLUME=0.8
SPEECH_SPEED=1.0
SILENCE_TIMEOUT_SECONDS=5.0

# ==========================================
# GLOBAL HOTKEYS
# ==========================================
# Registered system-wide while the GUI runs:
#   Ctrl+Space        show/hide the JARVIS panel
#   Ctrl+Shift+J      start/stop voice listening
#   Ctrl+Shift+C      open the Command Center
#   Ctrl+Shift+X      cancel the running task

# ==========================================
# UI SETTINGS
# ==========================================
AUTO_START=true
START_MINIMIZED=false
THEME=dark
ANIMATIONS_ENABLED=true
FLOATING_ORB_POSITION=right
FLOATING_ORB_SIZE=compact

# ==========================================
# SECURITY
# ==========================================
REQUIRE_CONFIRMATION_SENSITIVE=true
REQUIRE_CONFIRMATION_DANGEROUS=true
AUDIT_LOG_ENABLED=true
SANDBOX_MODE=false

# ==========================================
# GITHUB
# ==========================================
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_DEFAULT_VISIBILITY=private

# ==========================================
# PATHS
# ==========================================
JARVIS_DATA_DIR=%APPDATA%\Jarvis
JARVIS_PROJECTS_DIR=%USERPROFILE%\Projects
JARVIS_TEMP_DIR=%TEMP%\jarvis

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
LOG_FILE_MAX_MB=10
LOG_FILE_COUNT=5
LOG_CONSOLE=true

# ==========================================
# DIAGNOSTICS
# ==========================================
DIAGNOSTICS_ENABLED=true
TELEMETRY_ENABLED=false